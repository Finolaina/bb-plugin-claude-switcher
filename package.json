{
  "name": "bb-plugin-claude-accounts",
  "version": "0.1.0",
  "type": "module",
  "description": "See every Claude Code account's usage windows in bb and switch a project to another account when a turn hits a subscription limit.",
  "license": "MIT",
  "author": {
    "name": "Aitor Mariscal",
    "github": "Finolaina"
  },
  "homepage": "https://github.com/Finolaina/bb-plugin-claude-accounts#readme",
  "bugs": {
    "url": "https://github.com/Finolaina/bb-plugin-claude-accounts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Finolaina/bb-plugin-claude-accounts"
  },
  "keywords": [
    "bb-plugin",
    "bb",
    "claude",
    "claude-code",
    "anthropic",
    "multi-account",
    "usage",
    "rate-limit",
    "subscription"
  ],
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Claude accounts",
    "description": "See every Claude Code account in one usage panel and move a project to a free account when a turn hits a subscription limit.",
    "branding": {
      "icon": "Repeat"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "build": "bb plugin build",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
