{
  "name": "bb-plugin-claude-switcher",
  "version": "0.2.33",
  "type": "module",
  "description": "See every Claude Code account's usage windows in bb, pick the account before a new thread's first message, start new projects on the best account and switch a project to another account when a turn hits a subscription limit.",
  "license": "MIT",
  "author": {
    "name": "Aitor Mariscal",
    "github": "Finolaina"
  },
  "homepage": "https://github.com/Finolaina/bb-plugin-claude-switcher#readme",
  "bugs": {
    "url": "https://github.com/Finolaina/bb-plugin-claude-switcher/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Finolaina/bb-plugin-claude-switcher"
  },
  "keywords": [
    "bb-plugin",
    "bb",
    "claude",
    "claude-code",
    "anthropic",
    "multi-account",
    "usage",
    "rate-limit",
    "subscription"
  ],
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Claude Switcher",
    "description": "See every Claude Code account in one usage panel, pick the account before a new thread's first message, start new projects on the best account and move a project to a free account when a turn hits a subscription limit.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "build": "bb plugin build",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "^0.6.105",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.14",
    "oxlint": "^1.90.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
